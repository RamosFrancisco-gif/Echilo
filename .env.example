# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Só é preciso em produção. O `Origin` que o browser envia tem de constar aqui,
# senão o formulário de contacto dá 403 com o resto do sítio a funcionar.
DJANGO_CSRF_TRUSTED_ORIGINS=
# 0 fecha a ligação assim que o pedido acaba. É o certo para serverless, onde a
# função morre a seguir e não há processo que reaproveite a ligação.
DJANGO_CONN_MAX_AGE=0
# Só em produção, e é obrigatório lá. Sem esta linha, o `collectstatic` do build
# da Vercel corre com as settings de desenvolvimento e fica sem manifesto: o
# sítio sobe sem CSS, com 200 e sem nada na consola.
DJANGO_SETTINGS_MODULE=

# Base de dados (MySQL)
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=echilo
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
DJANGO_DB_TIMEOUT=10

# TLS da ligação MySQL. O `DJANGO_DB_SSL_CA` aponta para o `ca.pem` do serviço
# Aiven, que se descarrega em Connection settings e se versiona em
# `config/certs/`. É obrigatório quando o `DJANGO_DB_HOST` não é local: sem a CA
# o PyMySQL tenta TLS mas não verifica o certificado, e recusa arrancar em vez
# de deixar a senha da base passar pela rede sem prova de quem está do outro lado.
#
# Não se escreve aqui o `ssl-mode=REQUIRED` do URI do Aiven. O `OPTIONS` do MySQL
# vai tal e qual para o `connect()` do PyMySQL, e `ssl_mode` não é um parâmetro
# dele: a ligação morre com um `TypeError` e sem dizer nada sobre TLS.
DJANGO_DB_SSL_CA=
DJANGO_DB_SSL_VERIFICAR_HOST=true

# Ficheiros (Cloudinary)
#
# OBRIGATÓRIO em produção. `MEDIA_ROOT` é o disco da função, e o disco da função
# desaparece no fim da invocação: uma fotografia guardada aí é perdida no
# pedido seguinte. A produção recusa arrancar sem esta variável.
#
# O formato é cloudinary://<api_key>:<api_secret>@<cloud_name>. O `api_secret` é
# a palavra-passe da conta: se aparecer num sítio, no Git ou numa conversa, é para
# a regenerar no painel da Cloudinary e trocar aqui.
#
# Em desenvolvimento pode ficar vazia, e os ficheiros vão para `media/` no disco.
CLOUDINARY_URL=
# A Cloudinary guarda imagens em público e documentos legais em autenticado (§6).
# Em produção tem de ser `true` ou a aplicação recusa arrancar.
#
# Aqui fica `false` de propósito, e não `true`: a linha de cima está vazia, e um
# `true` com a URL vazia manda o desenvolvimento para um backend que não tem
# credencial. O ficheiro de exemplo é copiado tal qual, e o primeiro arranque
# local é em que este conflito apareceria. Em produção, ponhe-se `true` com a
# credencial em cima.
CLOUDINARY_PUBLICAO=false
# Tecto de um pedido, em bytes. Deixa-se em branco de propósito: a predefinição
# sai de `LIMITE_PEDIDO_MB` (`apps/core/validators.py`), que é 4,5 MB, e é o
# mesmo número que a plataforma recusa antes do Django ver o pedido. Escrever o
# valor aqui era uma segunda fonte do mesmo tecto — e foi essa duplicação que
# deixou as settings em 5 MiB enquanto a validação dos ficheiros usava 4.
DATA_UPLOAD_MAX_MEMORY_SIZE=
FILE_UPLOAD_MAX_MEMORY_SIZE=

# Cache e limitação de tentativas
#
# A tabela do cache é criada pela migration `core.0001_tabela_cache`, e é ela que
# faz o contador de tentativas de login sobreviver à invocação seguinte. Com o
# cache em memória, o limite de tentativas nunca era atingido.
DJANGO_CACHE_BD=true
DJANGO_CACHE_LOCATION=echilo_cache
DJANGO_CACHE_TIMEOUT=300

# SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Assistente de IA (Groq)
ECHILO_AI_API_KEY=
ECHILO_AI_MODEL=openai/gpt-oss-120b
ECHILO_AI_ENABLED=true
# O `vercel.json` corta a função aos 10 s. O timeout tem de ser menor que isso,
# e o total com retentativas também. Um timeout de 25 s com duas retentativas
# dava um 504 sem explicação depois de o utilizador ter escrito a pergunta.
ECHILO_AI_TIMEOUT=6
ECHILO_AI_MAX_RETRIES=0

# Mapa da pesquisa por área.
#
# NÃO É PRECISO NENHUMA CHAVE PARA O MAPA FUNCIONAR. O URL abaixo é a imagem
# aérea do Esri, que aceita tráfego sem registo. A linha ECHILO_MAP_TILE_KEY
# pode ficar vazia para sempre: só é lida se o URL tiver o marcador {key}, o que
# só acontece com um fornecedor pago.
#
# Dois fornecedores já foram rejeitados aqui, ambos por não se distinguirem do
# zero quando o mapa não carregava:
#   - tile.openstreetmap.org devolve 403 a um browser em 127.0.0.1;
#   - basemaps.cartocdn.com devolve HTTP 200 com um cartaz de "API KEY REQUIRED"
#     dentro da imagem, que o browser mostra como se fosse o mapa.
#
# O Esri serve em {z}/{y}/{x} e o Leaflet escreve {z}/{x}/{y}: a ordem está
# escrita no URL acima, e trocar os dois manda o mapa para o lado errado do mundo.
#
# Sempre que mudar esta linha, corra `python manage.py verify_map_tiles`: compara
# o tile de Luanda com o de Nairobi e o de São Paulo, e se forem a mesma imagem
# é um cartaz, não um mapa.
#
# Se a rede ou o fornecedor recusarem o pedido, o mapa mostra o aviso no painel
# e o filtro por área continua a funcionar pelo raio, sem depender de imagens.
# Produção: os termos de uso do Esri coverings exigem um acordo para uso
# comercial, por isso aí entra um fornecedor contratado com a atribuição dele.
ECHILO_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
ECHILO_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics
# Só para fornecedores com chave. Deixa vazio com o URL acima.
ECHILO_MAP_TILE_KEY=
ECHILO_MAP_CENTER_LAT=-8.8383
ECHILO_MAP_CENTER_LON=13.2344
# 12 enquadra Luanda. A 11 cabia Angola inteira, e um imóvel era um pixel.
# Com imóveis publicados o mapa abre enquadrado neles; este valor só pesa
# quando ainda não há nenhum.
ECHILO_MAP_DEFAULT_ZOOM=12
# A imagem aérea vem em cor natural: invertê-la falsearia a vegetação e a água,
# que são as pistas que servem para avaliar um terreno. Só ligues isto para um
# basemap vectorial claro, como o do OpenStreetMap.
ECHILO_MAP_INVERT_TILES=false

# Operação
ECHILO_WHATSAPP_NUMBER=
# Promoção de perfil da equipa. Nunca incluir a conta de SMTP partilhada.
MANAGER_EMAILS=
SITE_URL=http://127.0.0.1:8000
