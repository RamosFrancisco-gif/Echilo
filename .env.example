# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de dados (MySQL)
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=echilo
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Assistente de IA (Groq)
ECHILO_AI_API_KEY=
ECHILO_AI_MODEL=openai/gpt-oss-120b
ECHILO_AI_ENABLED=true

# Mapa da pesquisa por área.
#
# NÃO É PRECISO NENHUMA CHAVE PARA O MAPA FUNCIONAR. O URL abaixo é a imagem
# aérea do Esri, que aceita tráfego sem registo. A linha ECHILO_MAP_TILE_KEY
# pode ficar vazia para sempre: só é lida se o URL tiver o marcador {key}, o que
# só acontece com um fornecedor pago.
#
# Dois fornecedores já foram rejeitados aqui, ambos por não se distinguirem do
# zero quando o mapa não carregava:
#   - tile.openstreetmap.org devolve 403 a um browser em 127.0.0.1;
#   - basemaps.cartocdn.com devolve HTTP 200 com um cartaz de "API KEY REQUIRED"
#     dentro da imagem, que o browser mostra como se fosse o mapa.
#
# O Esri serve em {z}/{y}/{x} e o Leaflet escreve {z}/{x}/{y}: a ordem está
# escrita no URL acima, e trocar os dois manda o mapa para o lado errado do mundo.
#
# Sempre que mudar esta linha, corra `python manage.py verify_map_tiles`: compara
# o tile de Luanda com o de Nairobi e o de São Paulo, e se forem a mesma imagem
# é um cartaz, não um mapa.
#
# Se a rede ou o fornecedor recusarem o pedido, o mapa mostra o aviso no painel
# e o filtro por área continua a funcionar pelo raio, sem depender de imagens.
# Produção: os termos de uso do Esri coverings exigem um acordo para uso
# comercial, por isso aí entra um fornecedor contratado com a atribuição dele.
ECHILO_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
ECHILO_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics
# Só para fornecedores com chave. Deixa vazio com o URL acima.
ECHILO_MAP_TILE_KEY=
ECHILO_MAP_CENTER_LAT=-8.8383
ECHILO_MAP_CENTER_LON=13.2344
# 12 enquadra Luanda. A 11 cabia Angola inteira, e um imóvel era um pixel.
# Com imóveis publicados o mapa abre enquadrado neles; este valor só pesa
# quando ainda não há nenhum.
ECHILO_MAP_DEFAULT_ZOOM=12
# A imagem aérea vem em cor natural: invertê-la falsearia a vegetação e a água,
# que são as pistas que servem para avaliar um terreno. Só ligues isto para um
# basemap vectorial claro, como o do OpenStreetMap.
ECHILO_MAP_INVERT_TILES=false

# Operação
ECHILO_WHATSAPP_NUMBER=
# Promoção de perfil da equipa. Nunca incluir a conta de SMTP partilhada.
MANAGER_EMAILS=
SITE_URL=http://127.0.0.1:8000
